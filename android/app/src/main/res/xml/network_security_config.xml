<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Native board requests additionally require a literal RFC1918 IPv4 address.
         WebView always refuses mixed content; credentials only use fixed HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
